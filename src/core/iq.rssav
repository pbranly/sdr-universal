#[derive(Debug, Clone, Copy)]
pub struct IqSample {
    pub i: f32,
    pub q: f32,
}

#[derive(Debug)]
pub struct IqBlock {
    pub sequence: u64,
    pub timestamp: u64,
    pub center_frequency_hz: u64,
    pub sample_rate: u32,
    pub samples: Vec<IqSample>,
}

impl IqBlock {
    pub fn new(
        sequence: u64,
        timestamp: u64,
        center_frequency_hz: u64,
        sample_rate: u32,
        samples: Vec<IqSample>,
    ) -> Self {
        Self {
            sequence,
            timestamp,
            center_frequency_hz,
            sample_rate,
            samples,
        }
    }

    pub fn len(&self) -> usize {
        self.samples.len()
    }

    pub fn is_empty(&self) -> bool {
        self.samples.is_empty()
    }
}
