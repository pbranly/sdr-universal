}

#[repr(C)]
#[derive(Copy, Clone)]
struct SdrplayRspDuoParams {
    ext_ref_output_en: c_int,
}

#[repr(C)]
#[derive(Copy, Clone)]
struct SdrplayRspDuoResetSlaveFlags {
    reset_gain_update: u8,
