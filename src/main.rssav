mod backend;
mod core;

use anyhow::Result;
use backend::sdrplay::SdrplayBackend;
use std::io;
use std::sync::{
    atomic::{AtomicU64, Ordering},
    Arc,
};
use std::thread;

fn main() -> Result<()> {
    println!("=================================");
    println!(" SDR Universal");
    println!("=================================");

    let mut sdr = SdrplayBackend::new();

    println!("Ouverture de l'API SDRplay...");

    sdr.connect()?;

    println!();
    println!("API SDRplay ouverte.");
    println!("Connexion active : {}", sdr.is_connected());

    let iq_rx = sdr.take_iq_receiver().expect("Récepteur IQ déjà récupéré");

    let received_blocks = Arc::new(AtomicU64::new(0));
    let received_samples = Arc::new(AtomicU64::new(0));

    let received_blocks_thread = Arc::clone(&received_blocks);
    let received_samples_thread = Arc::clone(&received_samples);

    let iq_thread = thread::spawn(move || {
        let mut first_block = true;

        while let Ok(block) = iq_rx.recv() {
            received_blocks_thread.fetch_add(1, Ordering::Relaxed);
            received_samples_thread.fetch_add(block.len() as u64, Ordering::Relaxed);

            if first_block {
                first_block = false;

                println!();
                println!("=================================");
                println!(" IQ reçu par le Core !");
                println!("=================================");
                println!("  sequence       : {}", block.sequence);
                println!("  timestamp      : {}", block.timestamp);
                println!("  fréquence      : {} Hz", block.center_frequency_hz);
                println!("  sample rate    : {} Hz", block.sample_rate);
                println!("  échantillons   : {}", block.len());

                if let Some(sample) = block.samples.first() {
                    println!("  premier I      : {:.6}", sample.i);
                    println!("  premier Q      : {:.6}", sample.q);
                }

                println!();
            }
        }
    });

    println!();
    println!("Appuyer sur Entrée pour fermer...");

    let mut input = String::new();
    io::stdin().read_line(&mut input)?;

    let received = received_blocks.load(Ordering::Relaxed);
    let samples = received_samples.load(Ordering::Relaxed);
    let dropped = sdr.dropped_iq_blocks();

    println!();
    println!("=================================");
    println!(" Statistiques IQ");
    println!("=================================");
    println!("  blocs reçus   : {}", received);
    println!("  échantillons  : {}", samples);
    println!("  blocs perdus  : {}", dropped);
    println!("  total attendu : {}", received + dropped);

    if dropped == 0 {
        println!();
        println!("  RESULTAT : aucune perte IQ détectée.");
    } else {
        println!();
        println!("  RESULTAT : des blocs IQ ont été perdus.");
    }

    drop(sdr);

    let _ = iq_thread.join();

    Ok(())
}
